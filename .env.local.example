# Firebase web config (safe to expose; security enforced by Firestore rules + Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional deployment identity / versioning (have sensible defaults in lib/config.js).
# Bump the two PLAYBOOK_VERSION vars together when the master Playbook version changes
# (see playbook/README.md release checklist).
# NEXT_PUBLIC_COMPANY_LABEL=
# NEXT_PUBLIC_PLAYBOOK_VERSION=v3.1 (01 Jun 2026)
# NEXT_PUBLIC_PLAYBOOK_VERSION_TAG=v3.1

# AI assist (Claude) — server-side only; the key is NEVER exposed to the browser.
# Required for the in-app "Draft with Claude" / "Ask Claude" features (PRD OI6).
# Privileged clause text is sent to Anthropic's API only when these features are used.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # optional override
# NEXT_PUBLIC_AI_ASSIST=on               # set to "off" to hide the AI buttons

# Calibration auto-commit (optional) — server-side only. When "Calibrate into bank" is clicked,
# the live clause bank (Firestore) is always updated; if GITHUB_TOKEN is set, the change is ALSO
# committed to data/clauses.seed.json on the production branch so it survives a re-sync.
# Use a FINE-GRAINED PAT scoped to THIS repo only, Contents: Read and write. Without it, the
# live-bank calibration still works (repo commit is skipped). The .docx master is NOT auto-edited.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=ctambuan/legalops          # owner/repo (default)
# GITHUB_BRANCH=main                     # production branch (default)

# In-app "Save to Drive" for the master export (requires the drive.file OAuth scope to be
# enabled on the Google sign-in / consent screen). Off by default.
# NEXT_PUBLIC_DRIVE_UPLOAD=on
# NEXT_PUBLIC_DRIVE_FOLDER_ID=1EUxfSoMhazorsUNEbSPSqruhukd3Nure   # target Drive folder
