# Firebase web config (safe to expose; security enforced by Firestore rules + Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional deployment identity / versioning (have sensible defaults in lib/config.js).
# Bump the two PLAYBOOK_VERSION vars together when the master Playbook version changes
# (see playbook/README.md release checklist).
# NEXT_PUBLIC_COMPANY_LABEL=
# NEXT_PUBLIC_PLAYBOOK_VERSION=v3.1 (01 Jun 2026)
# NEXT_PUBLIC_PLAYBOOK_VERSION_TAG=v3.1
