# Firebase web config (safe to expose; security enforced by Firestore rules + Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional deployment identity / versioning (have sensible defaults in lib/config.js).
# Bump the two PLAYBOOK_VERSION vars together when the master Playbook version changes
# (see playbook/README.md release checklist).
# NEXT_PUBLIC_COMPANY_LABEL=
# NEXT_PUBLIC_PLAYBOOK_VERSION=v3.1 (01 Jun 2026)
# NEXT_PUBLIC_PLAYBOOK_VERSION_TAG=v3.1

# AI assist (Claude) — server-side only; the key is NEVER exposed to the browser.
# Required for the in-app "Draft with Claude" / "Ask Claude" features (PRD OI6).
# Privileged clause text is sent to Anthropic's API only when these features are used.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # optional override
# NEXT_PUBLIC_AI_ASSIST=on               # set to "off" to hide the AI buttons

# Calibration auto-commit + live re-sync (optional) — server-side only.
# - "Calibrate into bank" always updates the live clause bank (Firestore); if GITHUB_TOKEN is set
#   it ALSO commits the change to data/clauses.seed.json on the production branch.
# - "Re-sync from master" reads the LATEST data/clauses.seed.json live from the branch when
#   GITHUB_TOKEN is set (so it always catches the newest committed calibration, regardless of
#   deploy timing); without the token it falls back to the seed bundled at build time.
# Use a FINE-GRAINED PAT scoped to THIS repo only, Contents: Read and write.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=ctambuan/legalops          # owner/repo (default)
# GITHUB_BRANCH=main                     # production branch (default)

# In-app "Save to Drive" for the master export (requires the drive.file OAuth scope to be
# enabled on the Google sign-in / consent screen). Off by default.
# NEXT_PUBLIC_DRIVE_UPLOAD=on
# NEXT_PUBLIC_DRIVE_FOLDER_ID=1EUxfSoMhazorsUNEbSPSqruhukd3Nure   # target Drive folder
# The Document Number Generator reuses these two settings: when DRIVE_UPLOAD is on it keeps a
# single "Document Number Register (source of truth).csv" in the folder above, overwriting it
# after every generate so the file always matches the in-app Database tab. When off, use the
# "Download CSV" button in the Database tab instead. (Firestore is always the realtime store.)
