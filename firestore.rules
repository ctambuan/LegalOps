rules_version = '2';
// Firestore security rules — PRIVILEGED LEGAL DATA. Access enforced here, never trusted from client.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ---
    function isSignedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isAllowlisted() {
      return isSignedIn() && exists(/databases/$(database)/documents/allowlist/$(email()));
    }
    function alData() { return get(/databases/$(database)/documents/allowlist/$(email())).data; }
    function myRole() { return isAllowlisted() ? alData().role : ''; }
    function myCompanies() { return isAllowlisted() ? alData().companies : []; }

    // General Counsel = super-admin (group). The custom claim and the legacy 'reviewer'/'contributor'
    // roles (the original owner's account) normalise to GC.
    function isGC() {
      return isSignedIn() && (
        request.auth.token.reviewer == true ||
        (isAllowlisted() && (alData().role == 'gc' || alData().role == 'reviewer' || alData().role == 'contributor'))
      );
    }
    // Company scope: companies == 'all' (group) or a list of entity codes. GC covers everything.
    function hasCompany(c) {
      return isGC() || myCompanies() == 'all' || (myCompanies() is list && c in myCompanies());
    }
    // Checker for company c: GC, or that company's Head of Legal.
    function isApproverFor(c) {
      return isGC() || (myRole() == 'hol' && hasCompany(c));
    }
    // Maker for company c: GC, group-wide Regional Counsel, or in-scope Head of Legal / Country Counsel.
    function isMakerFor(c) {
      return isGC() || myRole() == 'regional' ||
        ((myRole() == 'hol' || myRole() == 'country') && hasCompany(c));
    }
    // Legacy alias: the older modules (Contracting review, DocGen settings) are GC-gated.
    function isReviewer() { return isGC(); }

    // --- allowlist: the workbench access list + per-user role (Team & Access / User Management) ---
    // Reviewer (Head of Legal) manages it from the app; no Admin SDK (org policy blocks SA keys), so
    // access control is enforced here. The owning user may read their own doc (to resolve role) and
    // stamp their own sign-in metadata (never their role/email). Approved email domains are pinned
    // here as the security boundary — adding a domain means editing this rule (and NEXT_PUBLIC_ALLOWED_USER_DOMAINS).
    function approvedDomain(e) {
      return e.matches('^[^@]+@(pluang[.]com|batubara-id[.]com)$');
    }
    match /allowlist/{e} {
      // Owner reads own doc (resolve role at sign-in); the GC reads all to manage the team.
      allow read: if (isSignedIn() && e == email()) || isGC();

      // Add a user: GC only; doc id == lowercased email on an approved domain; a valid group role.
      allow create: if isGC()
        && request.resource.data.email == e
        && approvedDomain(e)
        && request.resource.data.role in ['gc', 'regional', 'hol', 'country'];

      // GC edits (role / company-scope changes): email immutable; the GC may NOT change their OWN
      // role (no self-demote / lockout).
      allow update: if isGC()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role in ['gc', 'regional', 'hol', 'country']
        && (e != email() || request.resource.data.role == resource.data.role);

      // Self sign-in stamp: the owning user may update only sign-in metadata — never role, scope or email.
      allow update: if isSignedIn() && e == email()
        && request.resource.data.role == resource.data.role
        && request.resource.data.companies == resource.data.companies
        && request.resource.data.email == resource.data.email;

      // Off-board: GC only, and never your own account (no self-lockout).
      allow delete: if isGC() && e != email();
    }

    // --- clauses (seed reference): read-only to allowlisted users; never client-writable ---
    match /clauses/{id} {
      allow read: if isAllowlisted();
      allow write: if isReviewer(); // one-time load / re-seed via server-side /api/seed loader
    }

    // --- proposals ---
    match /proposals/{id} {
      allow read: if isAllowlisted();
      // create: allowlisted user submitting as themselves, status must start 'pending'
      allow create: if isAllowlisted()
        && request.resource.data.authorEmail == email()
        && request.resource.data.status == 'pending';
      // update: reviewer only, and the substantive fields must remain unchanged
      // (reviewer may change status, reviewNote, reviewerEmail, reviewedAt only).
      allow update: if isReviewer()
        && request.resource.data.text == resource.data.text
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.title == resource.data.title
        && request.resource.data.tier == resource.data.tier
        && request.resource.data.classification == resource.data.classification;
      allow delete: if false;
    }

    // --- adopted master: reviewer writes only; allowlisted read ---
    match /adopted/{id} {
      allow read: if isAllowlisted();
      allow write: if isReviewer();
    }

    // --- Company Data (cfg_*) — editable master data the tools read from; reviewer writes only ---
    // Entities (the doc id IS the company/entity code). Read = any allowlisted (shared group register).
    // Create a new company = GC (group structure). Edit/archive an existing one = that company's
    // approver (GC or its Head of Legal). Makers don't write live — they go through cfg_proposals.
    match /cfg_entities/{id} {
      allow read: if isAllowlisted();
      allow create: if isGC();
      allow update, delete: if isApproverFor(id);
      // Directors / Lines of Business / Signers (and any future subcollection) — scoped to the entity.
      match /{document=**} {
        allow read: if isAllowlisted();
        allow write: if isApproverFor(id);
      }
    }
    // Group-level config (approval matrix, agents, policies) — GC only for now; scoping added later.
    match /cfg_thresholds/{id} { allow read: if isAllowlisted(); allow write: if isGC(); }
    match /cfg_approvals/{id}  { allow read: if isAllowlisted(); allow write: if isGC(); }
    match /cfg_agents/{id}     { allow read: if isAllowlisted(); allow write: if isGC(); }
    match /cfg_policies/{id}   { allow read: if isAllowlisted(); allow write: if isGC(); }

    // Maker-checker queue. Proposals carry `company` (the entity code). A maker in scope creates;
    // creating a brand-new company is a group act (GC or Regional). Approve/reject = an approver for
    // that company, and never the proposer (separation of duties), except the GC backstop.
    match /cfg_proposals/{id} {
      allow read: if isAllowlisted();
      allow create: if isAllowlisted()
        && request.resource.data.proposerEmail == email()
        && request.resource.data.status == 'pending'
        && (request.resource.data.action == 'create'
              ? (isGC() || myRole() == 'regional')
              : (isMakerFor(request.resource.data.company)
                 && request.resource.data.company == request.resource.data.targetId));
      allow update: if isApproverFor(resource.data.company)
        && (resource.data.proposerEmail != email() || isGC());
      allow delete: if false;
    }

    // --- audit: append-only, immutable ---
    match /audit/{id} {
      allow read: if isReviewer();
      allow create: if isAllowlisted() && request.resource.data.actorEmail == email();
      allow update, delete: if false;
    }

    // --- Document Number Generator ---
    // docnumbers: any allowlisted user may generate (create as themselves). The number itself is
    // immutable — an allowlisted user may update only filing metadata (the Filing Tracker), which
    // we enforce by requiring the identifying fields to stay unchanged. A reviewer may do anything
    // (corrections, delete).
    match /docnumbers/{id} {
      allow read: if isAllowlisted();
      allow create: if isAllowlisted() && request.resource.data.authorEmail == email();
      allow update: if isReviewer() || (
        isAllowlisted()
        && request.resource.data.number == resource.data.number
        && request.resource.data.seq == resource.data.seq
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.usdEquivalent == resource.data.usdEquivalent
        && request.resource.data.approvers == resource.data.approvers
      );
      allow delete: if isReviewer();
    }

    // docgen_counters: per (year, series) sequence allocator. Allowlisted users increment it
    // inside the generate transaction, so they need write here.
    match /docgen_counters/{id} {
      allow read: if isAllowlisted();
      allow write: if isAllowlisted();
    }

    // docgen_settings: approver matrix + defaults — reviewer writes only, allowlisted read.
    match /docgen_settings/{id} {
      allow read: if isAllowlisted();
      allow write: if isReviewer();
    }

    // docgen_meta: small pointer doc (Drive mirror file id) — allowlisted read/write.
    match /docgen_meta/{id} {
      allow read: if isAllowlisted();
      allow write: if isAllowlisted();
    }

    // --- Task Tracker and Report ---
    // report_settings: roster + matter-group overrides — reviewer writes only, allowlisted read.
    match /report_settings/{id} {
      allow read: if isAllowlisted();
      allow write: if isReviewer();
    }

    // report_matters: each allowlisted user logs their own matters (create/update/delete as
    // themselves and they keep ownership); a reviewer may read and manage all (whole-team view).
    match /report_matters/{id} {
      allow read: if isReviewer() || (isAllowlisted() && resource.data.authorEmail == email());
      allow create: if isAllowlisted() && request.resource.data.authorEmail == email();
      allow update: if isReviewer() || (
        isAllowlisted()
        && resource.data.authorEmail == email()
        && request.resource.data.authorEmail == resource.data.authorEmail
      );
      allow delete: if isReviewer() || (isAllowlisted() && resource.data.authorEmail == email());
    }

    // weekly_reports: same author-or-reviewer visibility. The author owns their personal draft;
    // a reviewer may read all and assemble/curate the combined report.
    match /weekly_reports/{id} {
      allow read: if isReviewer() || (isAllowlisted() && resource.data.authorEmail == email());
      allow create: if isAllowlisted() && request.resource.data.authorEmail == email();
      allow update: if isReviewer() || (
        isAllowlisted()
        && resource.data.authorEmail == email()
        && request.resource.data.authorEmail == resource.data.authorEmail
      );
      allow delete: if isReviewer() || (isAllowlisted() && resource.data.authorEmail == email());
    }
  }
}
